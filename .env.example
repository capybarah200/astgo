# Скопируйте в .env и впишите ключ. Файл .env не попадает в git.
GEMINI_API_KEY=
# Необязательно. Модели по очереди, от сильнейшей, через запятую: кончилась квота у одной — отвечает следующая.
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# Уровень «размышления» модели (low — быстрее; пусто — не передавать)
# GEMINI_THINKING=low
